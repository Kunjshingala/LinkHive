<?xml version="1.0" encoding="utf-8"?>
<!--
  Today widget color tokens — dark values, mirroring app_colors.dart's dark set.
  Pastel accents and widget_on_accent stay identical to values/ on purpose:
  the pastel fills don't change between themes, so text drawn on them must
  not change either.
-->
<resources>
    <color name="widget_surface">#FF1E1E1E</color>
    <color name="widget_border">#FFE5E7EB</color>
    <color name="widget_text_primary">#FFE5E7EB</color>
    <color name="widget_text_secondary">#FFA3A3A3</color>
    <color name="widget_text_tertiary">#FF737373</color>

    <!-- Lighter blue so the host stays readable on a dark surface. -->
    <color name="widget_host">#FF93C5FD</color>

    <!-- Constant — see values/widget_colors.xml. -->
    <color name="widget_on_accent">#FF1E1E1E</color>

    <color name="widget_accent_orange">#FFFEF0C7</color>
    <color name="widget_accent_blue">#FFD1E9FF</color>
    <color name="widget_success">#FF22C55E</color>
</resources>
